{
  "KeyVaultName": "your-keyvault-name",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "yourdomain.onmicrosoft.com",
    "TenantId": "REDACTED",
    "ClientId": "REDACTED",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:<server-name>.database.windows.net;Database=<database-name>;Authentication=Active Directory Default;TrustServerCertificate=True"
  },
  "ServiceBus": {
    "FullyQualifiedNamespace": "<your-namespace>.servicebus.windows.net",
    "QueueName": "contoso-university-notifications"
  },
  "Storage": {
    "ServiceUri": "https://<your-storage-account-name>.blob.core.windows.net",
    "TeachingMaterialsContainer": "teaching-materials",
    "StaticFilesContainer": "static-files",
    "StaticFilesBaseUrl": "https://<your-storage-account-name>.blob.core.windows.net/static-files"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
